[Unit]
Description=Love Memories SQL API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/love-memories-source
EnvironmentFile=/etc/love-memories-api.env
ExecStart=/usr/bin/node api/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/love-memories

[Install]
WantedBy=multi-user.target
